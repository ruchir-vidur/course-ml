# Copy to course-ml/.env and fill in. Loaded automatically by src/api.py.

# Groq API key for the LLM. Falls back to the key in chat.py if unset (rotate it!).
GROQ_API_KEY=

# MongoDB (the Vidur course catalog). Used to build an accurate course id→title
# map so the server can resolve whatever the frontend sends to the right indexed
# course. Same value as vidur-backend/backend/.env MONGO_URI.
# If unset, the server still works using title-only matching against the
# transcript folder names.
MONGO_URI=

# Optional: override the database name (otherwise taken from the URI path).
# MONGO_DB=sattvastha
